# ─────────────────────────────────────────
# QA Test Case Filter Agent — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub
# ─────────────────────────────────────────

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Jira Configuration
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_TOKEN=your_jira_api_token_here

# TestRail Configuration
TESTRAIL_BASE_URL=https://yourcompany.testrail.io
TESTRAIL_EMAIL=your-email@company.com
TESTRAIL_TOKEN=your_testrail_api_token_here
TESTRAIL_SUITE_ID=your_test_suite_id_here

# Project Configuration
DEFAULT_PROJECT_KEY=EH
TOTAL_TEST_CASES=5000
BATCH_SIZE=100
